# ── Django Core ────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ────────────────────────────────────────────────────────────────────
# Leave DB_ENGINE unset for SQLite (local dev default).
# Set DB_ENGINE=django.db.backends.mysql for MySQL/MariaDB.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=songgen
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Google OAuth (django-allauth) ──────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# Authorized redirect URI: http://127.0.0.1:8000/accounts/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Strategy Pattern ───────────────────────────────────────────────────────────
# mock  → instant offline generation (default, no API key needed)
# suno  → real Suno API (requires SUNO_API_KEY below)
GENERATOR_STRATEGY=mock

# Suno API key — NEVER commit this value
# Obtain at https://api.sunoapi.org
SUNO_API_KEY=
